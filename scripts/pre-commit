#!/bin/sh
# Blocks commits that include secret files or credentials:
#   .env files, .streamlit/secrets.toml, OpenRouter keys (sk-or-...),
#   and Postgres connection strings with an embedded password.
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)|(^|/)\.streamlit/secrets\.toml$' | grep -v '\.env\.example$' >/dev/null; then
  echo "ERROR: secret file staged (.env or .streamlit/secrets.toml). Unstage it: git reset HEAD <file>" >&2; exit 1
fi
if git diff --cached -U0 | grep -E '^\+.*sk-or-[A-Za-z0-9_-]{16,}' >/dev/null; then
  echo "ERROR: possible OpenRouter API key in staged changes." >&2; exit 1
fi
if git diff --cached -U0 | grep -E '^\+.*postgres(ql)?://[^:/[:space:]]+:[^@[:space:]]+@' >/dev/null; then
  echo "ERROR: Postgres connection string with a password in staged changes." >&2; exit 1
fi
